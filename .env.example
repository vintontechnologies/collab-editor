# Copy this file to .env and fill it in. The real .env is never committed.
# Generate a key with: openssl rand -hex 32
SECRET_KEY=change-me
# The public address of the app. Used in invitation emails.
FRONTEND_URL=http://localhost:8080
ALLOWED_HOSTS=*
WEB_PORT=8080
# Only on a brand-new server (it must match an existing database volume):
# DB_PASSWORD=choose-a-strong-password
# Real invitation emails (otherwise they are printed in: docker compose logs backend)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
