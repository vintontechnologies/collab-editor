# One image for hosting: Django (Daphne) serves both the API/WebSockets and the React build

# Stage 1: build the React app
FROM node:22-alpine AS frontend
WORKDIR /client
ENV NODE_OPTIONS=--dns-result-order=ipv4first
COPY client/package*.json ./
RUN npm config set fetch-retries 5 && npm config set fetch-timeout 300000 && npm ci
COPY client/ .
RUN npm run build

# Stage 2: the Django server, with the build copied next to it
FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY server/requirements.txt .
RUN pip install --no-cache-dir --default-timeout=120 --retries 5 -r requirements.txt
COPY server/ .
COPY --from=frontend /client/dist /app/frontend
RUN chmod +x entrypoint.sh
EXPOSE 10000
ENTRYPOINT ["./entrypoint.sh"]
